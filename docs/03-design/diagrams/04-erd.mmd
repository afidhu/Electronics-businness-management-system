  ROLE {
    uuid id PK
    string key UK "SYSTEM_ADMIN, MANAGER, ..."
    string name
    int max_branches "null = unlimited"
    boolean is_system
  }
  PERMISSION {
    uuid id PK
    string key UK "e.g. sales:create"
    string description
  }
  ROLE_PERMISSION {
    uuid role_id PK,FK
    uuid permission_id PK,FK
  }
  USER {
    uuid id PK
    string email UK "normalised lower-case"
    string full_name
    string password_hash "Argon2id"
    uuid role_id FK
    boolean is_active
    int failed_login_attempts
    datetime locked_until
    datetime last_login_at
    datetime password_changed_at
  }
  BRANCH {
    uuid id PK
    string code UK "upper-case, immutable"
    string name
    string address
    string phone
    boolean is_active
  }
  USER_BRANCH {
    uuid user_id PK,FK
    uuid branch_id PK,FK
    uuid assigned_by_id FK
    datetime assigned_at
  }
  REFRESH_TOKEN {
    uuid id PK
    uuid user_id FK
    string token_hash UK "SHA-256 hex"
    uuid family_id "one login session"
    datetime expires_at "<= session_expires_at"
    datetime session_expires_at "login + 30 days, copied on rotation"
    datetime revoked_at
    string revoked_reason
    uuid replaced_by_id FK,UK
  }
  CATEGORY {
    uuid id PK
    string name
    string name_key UK "lower-case; case-insensitive unique"
    string description
    boolean is_active
  }
  BRAND {
    uuid id PK
    string name
    string name_key UK "lower-case; case-insensitive unique"
    boolean is_active
  }
  PRODUCT {
    uuid id PK
    string sku UK "upper-case, immutable"
    string name
    string description
    enum tracking_mode "SERIALIZED | QUANTITY, immutable"
    enum identifier_type "IMEI | SERIAL (serialized only)"
    int identifiers_per_unit "1-2 (serialized only)"
    decimal cost_price "14,2 TZS"
    decimal selling_price "14,2 TZS, tax-exclusive"
    int reorder_level
    json specifications
    boolean is_active
    uuid category_id FK
    uuid brand_id FK
    uuid created_by_id FK
    uuid updated_by_id FK
  }
  PRODUCT_UNIT {
    uuid id PK
    uuid product_id FK "SERIALIZED products only"
    uuid branch_id FK
    enum status "IN_STOCK|IN_TRANSIT|RESERVED|SOLD|RETURNED|UNDER_REPAIR|WRITTEN_OFF"
    decimal unit_cost
    uuid goods_receipt_item_id FK
  }
  UNIT_IDENTIFIER {
    uuid id PK
    uuid product_unit_id FK
    enum type "IMEI|SERIAL"
    string value UK "normalised; never reused"
    boolean is_primary
  }
  GOODS_RECEIPT_ITEM {
    uuid id PK
    uuid goods_receipt_id FK
    uuid purchase_item_id FK
    uuid product_id FK
    int quantity
    decimal unit_cost "from PO line"
  }
  INVENTORY_VALUATION {
    uuid product_id PK
    decimal average_cost "18,4 moving WAC"
  }
  STOCK_BALANCE {
    uuid product_id PK,FK
    uuid branch_id PK,FK
    int on_hand ">= 0"
    int reserved "0 until POS"
  }
  SUPPLIER {
    uuid id PK
    string name
    string name_key UK "case-insensitive"
    string contact_person
    string phone
    string email
    string address
    string tin UK "nullable; unique when set"
    string notes
    boolean is_active
  }
  PURCHASE {
    uuid id PK
    string reference UK "PO-BRANCH-YYYY-NNNNNN"
    uuid supplier_id FK
    uuid branch_id FK
    enum status "DRAFT|SUBMITTED|APPROVED|REJECTED|PARTIALLY_RECEIVED|RECEIVED|CANCELLED"
    string currency "TZS"
    decimal subtotal "server-computed"
    string supplier_reference
    date expected_delivery_date
    string notes
    uuid created_by_id FK
    uuid submitted_by_id FK
    uuid approved_by_id FK "CHECK <> creator, submitter"
    uuid rejected_by_id FK "CHECK <> creator, submitter"
    string rejection_reason
    uuid cancelled_by_id FK
    string cancellation_reason
  }
  PURCHASE_ITEM {
    uuid id PK
    uuid purchase_id FK
    int line_number
    uuid product_id FK "UK with purchase_id"
    string product_name "snapshot"
    int quantity_ordered "> 0"
    int quantity_received "Module 5 only"
    decimal unit_cost "> 0, tax-exclusive"
    decimal line_total
  }
  DOCUMENT_SEQUENCE {
    string scope PK "e.g. PO:DSM01:2026"
    int last_value
  }
  GOODS_RECEIPT {
    uuid id PK
    string reference UK "GRN-BRANCH-YYYY-NNNNNN"
    uuid purchase_id FK
    uuid branch_id FK
    uuid received_by_id FK "not creator/submitter/approver"
    string idempotency_key UK
    string supplier_delivery_ref
    string supplier_invoice_ref
  }
  STOCK_MOVEMENT {
    uuid id PK
    uuid product_id FK
    uuid branch_id FK
    enum movement_type
    int quantity_delta "non-zero"
    decimal unit_cost
    decimal value_delta
    uuid product_unit_id FK
    string reference_type
    uuid reference_id
    uuid actor_id FK
  }
  CUSTOMER {
    uuid id PK
    string name
    string phone
  }
  SALE {
    uuid id PK
    string receipt_number UK
    uuid customer_id FK
    uuid cashier_id FK
    uuid branch_id FK
    decimal total
    string status
  }
  SALE_ITEM {
    uuid id PK
    uuid sale_id FK
    uuid product_id FK
    uuid product_unit_id FK
    decimal quantity
    decimal unit_price
  }
  PAYMENT {
    uuid id PK
    uuid sale_id FK
    string method
    decimal amount
    string reference
  }
  WARRANTY {
    uuid id PK
    uuid sale_id FK
    uuid product_unit_id FK
    uuid customer_id FK
    date start_date
    date end_date
  }
  AUDIT_LOG {
    uuid id PK
    uuid actor_id FK "null for anonymous events"
    string action
    string entity_type
    uuid entity_id
    uuid branch_id FK "branch scoping"
    json metadata "no secrets"
    string ip_address
    string request_id
    datetime created_at "append-only (DB trigger)"
  }
