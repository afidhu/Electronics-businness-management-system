# Copy to .env and fill in real values. NEVER commit .env or .env.test.

# --- Database (Prisma 7; see prisma.config.ts and ADR-009) ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/electrocore_db?schema=public"
# Development only: dedicated, empty shadow DB for `prisma migrate dev`
# (create it with TEMPLATE template0). Not needed in production.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/electrocore_db_shadow?schema=public"

# --- Application ---
NODE_ENV=development          # development | test | production
PORT=3000
CORS_ORIGINS=http://localhost:5173   # comma-separated browser origins
LOG_LEVEL=log                 # error | warn | log | debug | verbose
# SWAGGER_ENABLED=true        # default: true outside production, false in production

# Approved business defaults (ADR-011). Tax rates are NOT set here (ADR-012).
BUSINESS_TIMEZONE=Africa/Dar_es_Salaam
CURRENCY=TZS

# Tests use a separate .env.test (same keys) whose DATABASE_URL must point to
# a database named *_test_db, e.g. electrocore_test_db.

# --- Authentication (ADR-017, ADR-018) ---
JWT_ACCESS_SECRET="CHANGE_ME: openssl rand -base64 48"   # >= 32 chars, unique per environment
JWT_ACCESS_TTL_SECONDS=900          # 15-minute access tokens
REFRESH_TOKEN_TTL_DAYS=7            # refresh tokens (rotated on every use)
SESSION_MAX_LIFETIME_DAYS=30        # absolute session cap; rotation never extends past it
COOKIE_SECURE=false                 # true required in production (HTTPS)
TRUST_PROXY=0                       # reverse-proxy hops to trust for client IP (1 behind Nginx/Caddy)
LOGIN_RATE_LIMIT=5                  # login attempts per IP per window
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5         # consecutive failures before temporary lockout
LOGIN_LOCKOUT_MINUTES=15

# Initial administrator created by `npm run db:seed` (only if absent).
# Password must satisfy the policy (>= 12 chars). Remove it from .env after seeding.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD=
