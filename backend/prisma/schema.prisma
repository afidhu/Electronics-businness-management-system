// ElectroCore EBMS — Prisma schema.
// Domain models are added module by module (see docs/).
// The connection URL is supplied by prisma.config.ts (Prisma 7), not here.
//
// Conventions (ADR-011, data dictionary "Physical conventions"):
// - UUID primary keys; snake_case table/column names via @@map/@map.
// - Timestamps: timestamptz, stored in UTC. Money: Decimal(14,2).
// - Referenced business records are deactivated, not hard-deleted.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Module 2 — Identity, access control and audit (ADR-016 .. ADR-020)
// ---------------------------------------------------------------------------

/// Role grouping permissions. System roles are seeded and read-only via the API.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  /// Stable key, e.g. SYSTEM_ADMIN, CASHIER.
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// Max branch assignments for users with this role; null = unlimited.
  maxBranches Int?     @map("max_branches")
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

/// Fine-grained capability, e.g. `sales:create`.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(100)
  description String @db.VarChar(500)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Business stock/sales location.
model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  /// Short unique code, e.g. DSM01 (stored upper-case).
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(150)
  address   String?  @db.VarChar(300)
  phone     String?  @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users          UserBranch[]
  goodsReceipts  GoodsReceipt[]
  productUnits   ProductUnit[]
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  purchases      Purchase[]
  auditLogs      AuditLog[]

  @@map("branches")
}

/// Staff identity. Email is stored normalised (trimmed, lower-case).
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(254)
  fullName            String    @map("full_name") @db.VarChar(150)
  /// Argon2id PHC string. Never returned by the API or logged.
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  roleId              String    @map("role_id") @db.Uuid
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role               Role            @relation(fields: [roleId], references: [id])
  branches           UserBranch[]    @relation("UserBranches")
  assignedBy         UserBranch[]    @relation("BranchAssigner")
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  productsCreated    Product[]       @relation("ProductCreatedBy")
  productsUpdated    Product[]       @relation("ProductUpdatedBy")
  purchasesCreated   Purchase[]      @relation("PurchaseCreatedBy")
  purchasesUpdated   Purchase[]      @relation("PurchaseUpdatedBy")
  purchasesSubmitted Purchase[]      @relation("PurchaseSubmittedBy")
  purchasesApproved  Purchase[]      @relation("PurchaseApprovedBy")
  purchasesRejected  Purchase[]      @relation("PurchaseRejectedBy")
  purchasesCancelled Purchase[]      @relation("PurchaseCancelledBy")
  goodsReceipts      GoodsReceipt[]
  stockMovements     StockMovement[]

  @@index([roleId])
  @@map("users")
}

/// Grants a user access to a branch (FR-ADM-01).
model UserBranch {
  userId       String   @map("user_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user       User   @relation("UserBranches", fields: [userId], references: [id], onDelete: Cascade)
  branch     Branch @relation(fields: [branchId], references: [id])
  assignedBy User?  @relation("BranchAssigner", fields: [assignedById], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

/// Opaque refresh token, stored only as a SHA-256 hash (ADR-017).
/// Tokens of one login session share a `familyId`; rotation links them.
model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.Char(64)
  familyId         String    @map("family_id") @db.Uuid
  /// Rotation never extends beyond this: expiresAt <= sessionExpiresAt.
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Absolute end of the login session (login + SESSION_MAX_LIFETIME_DAYS), copied on rotation.
  sessionExpiresAt DateTime  @map("session_expires_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// ROTATED | LOGOUT | LOGOUT_ALL | REUSE_DETECTED | PASSWORD_CHANGED | USER_DEACTIVATED
  revokedReason    String?   @map("revoked_reason") @db.VarChar(30)
  replacedById     String?   @unique @map("replaced_by_id") @db.Uuid

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("Rotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("Rotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Append-only history of sensitive actions (FR-ADM-02, FR-AUTH-06).
/// Metadata must never contain passwords, tokens or secrets.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// Null for anonymous events (e.g. a failed login for an unknown email).
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.Uuid
  /// Branch the event belongs to, used for branch-scoped audit reading.
  branchId   String?  @map("branch_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor  User?   @relation(fields: [actorId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([branchId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Module 3 — Product catalogue (ADR-025; docs/proposals/module-3-catalogue.md)
// Organisation-wide (not branch-scoped). Deactivate, never delete.
// ---------------------------------------------------------------------------

enum TrackingMode {
  SERIALIZED
  QUANTITY
}

/// Identifier captured per physical unit of a SERIALIZED product (Module 5).
enum IdentifierType {
  IMEI
  SERIAL
}

/// Flat product classification (D11).
model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  /// lower-case, whitespace-collapsed name: makes names case-insensitively unique.
  nameKey     String   @unique @map("name_key") @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  nameKey   String   @unique @map("name_key") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([isActive])
  @@map("brands")
}

/// Product model / SKU (ADR-004). Physical serialized units are ProductUnit (Module 5).
model Product {
  id                 String          @id @default(uuid()) @db.Uuid
  /// Upper-case, immutable, unique across the organisation (FR-CAT-03, D9).
  sku                String          @unique @db.VarChar(40)
  name               String          @db.VarChar(200)
  description        String?         @db.VarChar(2000)
  categoryId         String          @map("category_id") @db.Uuid
  brandId            String          @map("brand_id") @db.Uuid
  /// Immutable after creation (D9).
  trackingMode       TrackingMode    @map("tracking_mode")
  /// SERIALIZED only; immutable.
  identifierType     IdentifierType? @map("identifier_type")
  /// SERIALIZED only (1 or 2, e.g. dual-SIM IMEIs); immutable.
  identifiersPerUnit Int?            @map("identifiers_per_unit")
  /// TZS. Hidden from users without catalogue:cost_read (D4).
  costPrice          Decimal         @map("cost_price") @db.Decimal(14, 2)
  /// TZS, tax-exclusive (D7), organisation-wide (D8).
  sellingPrice       Decimal         @map("selling_price") @db.Decimal(14, 2)
  reorderLevel       Int             @default(0) @map("reorder_level")
  /// Flat descriptive attributes, e.g. { "ram": "16GB" }.
  specifications     Json            @default("{}")
  isActive           Boolean         @default(true) @map("is_active")
  createdById        String?         @map("created_by_id") @db.Uuid
  updatedById        String?         @map("updated_by_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  category          Category            @relation(fields: [categoryId], references: [id])
  brand             Brand               @relation(fields: [brandId], references: [id])
  purchaseItems     PurchaseItem[]
  goodsReceiptItems GoodsReceiptItem[]
  units             ProductUnit[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  valuation         InventoryValuation?
  createdBy         User?               @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?               @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Module 4 — Procurement (ADR-027; docs/proposals/module-4-procurement.md)
// Receiving (quantity_received, PARTIALLY_RECEIVED/RECEIVED) belongs to Module 5.
// ---------------------------------------------------------------------------

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

/// Organisation-wide supplier master record (P11). No payment/bank data.
model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @db.VarChar(150)
  /// lower-case, whitespace-collapsed name: case-insensitive uniqueness.
  nameKey       String   @unique @map("name_key") @db.VarChar(150)
  contactPerson String?  @map("contact_person") @db.VarChar(150)
  phone         String?  @db.VarChar(30)
  email         String?  @db.VarChar(254)
  address       String?  @db.VarChar(300)
  /// Tanzanian TIN, 9 digits (normalised); unique when set.
  tin           String?  @unique @db.VarChar(9)
  notes         String?  @db.VarChar(1000)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  purchases Purchase[]

  @@index([isActive])
  @@map("suppliers")
}

/// Purchase order (FR-PUR-02). Separation of duties enforced by DB CHECKs.
model Purchase {
  id                   String         @id @default(uuid()) @db.Uuid
  /// PO-{BRANCHCODE}-{YYYY}-{NNNNNN}; immutable (P6).
  reference            String         @unique @db.VarChar(40)
  supplierId           String         @map("supplier_id") @db.Uuid
  branchId             String         @map("branch_id") @db.Uuid
  status               PurchaseStatus @default(DRAFT)
  currency             String         @default("TZS") @db.Char(3)
  /// Sum of line totals, computed by the server (tax-exclusive).
  subtotal             Decimal        @default(0) @db.Decimal(14, 2)
  supplierReference    String?        @map("supplier_reference") @db.VarChar(100)
  expectedDeliveryDate DateTime?      @map("expected_delivery_date") @db.Date
  notes                String?        @db.VarChar(1000)

  createdById        String    @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedById        String    @map("updated_by_id") @db.Uuid
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  submittedById      String?   @map("submitted_by_id") @db.Uuid
  submittedAt        DateTime? @map("submitted_at") @db.Timestamptz(3)
  approvedById       String?   @map("approved_by_id") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz(3)
  approvalNote       String?   @map("approval_note") @db.VarChar(500)
  rejectedById       String?   @map("rejected_by_id") @db.Uuid
  rejectedAt         DateTime? @map("rejected_at") @db.Timestamptz(3)
  rejectionReason    String?   @map("rejection_reason") @db.VarChar(500)
  cancelledById      String?   @map("cancelled_by_id") @db.Uuid
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(500)

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  branch        Branch         @relation(fields: [branchId], references: [id])
  createdBy     User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  updatedBy     User           @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id])
  submittedBy   User?          @relation("PurchaseSubmittedBy", fields: [submittedById], references: [id])
  approvedBy    User?          @relation("PurchaseApprovedBy", fields: [approvedById], references: [id])
  rejectedBy    User?          @relation("PurchaseRejectedBy", fields: [rejectedById], references: [id])
  cancelledBy   User?          @relation("PurchaseCancelledBy", fields: [cancelledById], references: [id])
  items         PurchaseItem[]
  goodsReceipts GoodsReceipt[]

  @@index([branchId, status])
  @@index([supplierId, status])
  @@index([status])
  @@index([createdAt])
  @@map("purchases")
}

/// One product per line (P9). Lines frozen outside DRAFT (trigger).
model PurchaseItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseId       String  @map("purchase_id") @db.Uuid
  lineNumber       Int     @map("line_number")
  productId        String  @map("product_id") @db.Uuid
  /// Product name at order time (documents stay readable after renames).
  productName      String  @map("product_name") @db.VarChar(200)
  /// Whole units (P7).
  quantityOrdered  Int     @map("quantity_ordered")
  /// Written ONLY by Module 5 receiving.
  quantityReceived Int     @default(0) @map("quantity_received")
  /// TZS, > 0, tax-exclusive (P8).
  unitCost         Decimal @map("unit_cost") @db.Decimal(14, 2)
  /// quantity_ordered * unit_cost (DB CHECK).
  lineTotal        Decimal @map("line_total") @db.Decimal(14, 2)

  purchase     Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  receiptItems GoodsReceiptItem[]
  product      Product            @relation(fields: [productId], references: [id])

  @@unique([purchaseId, productId])
  @@unique([purchaseId, lineNumber])
  @@index([productId])
  @@map("purchase_items")
}

/// Atomic document counters, e.g. scope "PO:DSM01:2026" (P6). Reusable.
model DocumentSequence {
  scope     String   @id @db.VarChar(100)
  lastValue Int      @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Module 5 — Inventory, stage 5.1 (ADR-029, ADR-030; proposals/module-5-inventory.md)
// Stage 5.2 (adjustments, transfers, close short) is deferred: no tables yet.
// ---------------------------------------------------------------------------

/// Ledger movement types (full approved list; 5.1 writes PURCHASE_RECEIPT only).
enum MovementType {
  OPENING_BALANCE
  PURCHASE_RECEIPT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
  TRANSFER_OUT
  TRANSFER_IN
}

/// Serialized unit lifecycle (FR-UNIT-02 + IN_TRANSIT, I11).
enum UnitStatus {
  IN_STOCK
  IN_TRANSIT
  RESERVED
  SOLD
  RETURNED
  UNDER_REPAIR
  WRITTEN_OFF
}

/// One goods-receiving event against a purchase order (FR-INV-08/09). Insert-only.
model GoodsReceipt {
  id                  String   @id @default(uuid()) @db.Uuid
  /// GRN-{BRANCHCODE}-{YYYY}-{NNNNNN}
  reference           String   @unique @db.VarChar(40)
  purchaseId          String   @map("purchase_id") @db.Uuid
  branchId            String   @map("branch_id") @db.Uuid
  /// BR-14: never the PO's creator, submitter (any cycle) or approver (trigger).
  receivedById        String   @map("received_by_id") @db.Uuid
  receivedAt          DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  supplierDeliveryRef String?  @map("supplier_delivery_ref") @db.VarChar(100)
  supplierInvoiceRef  String?  @map("supplier_invoice_ref") @db.VarChar(100)
  notes               String?  @db.VarChar(1000)
  /// Mandatory client key (I19); a replay returns this receipt.
  idempotencyKey      String   @unique @map("idempotency_key") @db.Uuid
  /// SHA-256 of the canonical request, to detect key reuse with another payload.
  requestHash         String   @map("request_hash") @db.Char(64)

  purchase   Purchase           @relation(fields: [purchaseId], references: [id])
  branch     Branch             @relation(fields: [branchId], references: [id])
  receivedBy User               @relation(fields: [receivedById], references: [id])
  items      GoodsReceiptItem[]

  @@index([purchaseId])
  @@index([branchId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String  @id @default(uuid()) @db.Uuid
  goodsReceiptId String  @map("goods_receipt_id") @db.Uuid
  purchaseItemId String  @map("purchase_item_id") @db.Uuid
  productId      String  @map("product_id") @db.Uuid
  quantity       Int
  /// Copied from the PO line (I20).
  unitCost       Decimal @map("unit_cost") @db.Decimal(14, 2)

  goodsReceipt GoodsReceipt  @relation(fields: [goodsReceiptId], references: [id])
  purchaseItem PurchaseItem  @relation(fields: [purchaseItemId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  units        ProductUnit[]

  @@unique([goodsReceiptId, purchaseItemId])
  @@index([purchaseItemId])
  @@map("goods_receipt_items")
}

/// One physical serialized device (ADR-004). Created by receiving (5.1).
model ProductUnit {
  id                 String     @id @default(uuid()) @db.Uuid
  productId          String     @map("product_id") @db.Uuid
  branchId           String     @map("branch_id") @db.Uuid
  status             UnitStatus @default(IN_STOCK)
  /// Receipt cost of this unit (traceability; valuation uses WAC, ADR-029).
  unitCost           Decimal    @map("unit_cost") @db.Decimal(14, 2)
  goodsReceiptItemId String?    @map("goods_receipt_item_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  product          Product           @relation(fields: [productId], references: [id])
  branch           Branch            @relation(fields: [branchId], references: [id])
  goodsReceiptItem GoodsReceiptItem? @relation(fields: [goodsReceiptItemId], references: [id])
  identifiers      UnitIdentifier[]
  movements        StockMovement[]

  @@index([productId, branchId, status])
  @@index([branchId, status])
  @@map("product_units")
}

/// IMEI/serial identifiers; value normalised and unique forever (D3, BR-17).
model UnitIdentifier {
  id            String         @id @default(uuid()) @db.Uuid
  productUnitId String         @map("product_unit_id") @db.Uuid
  type          IdentifierType
  value         String         @unique @db.VarChar(64)
  isPrimary     Boolean        @default(false) @map("is_primary")

  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])

  @@index([productUnitId])
  @@map("unit_identifiers")
}

/// Query-optimised projection of the ledger (BR-04, BR-16).
model StockBalance {
  productId String   @map("product_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  /// Stays 0 until POS reservations (I17).
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@id([productId, branchId])
  @@index([branchId])
  @@map("stock_balances")
}

/// Append-only inventory ledger (FR-INV-02, BR-04). Trigger blocks UPDATE/DELETE.
model StockMovement {
  id            String       @id @default(uuid()) @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  branchId      String       @map("branch_id") @db.Uuid
  movementType  MovementType @map("movement_type")
  quantityDelta Int          @map("quantity_delta")
  unitCost      Decimal      @map("unit_cost") @db.Decimal(14, 2)
  valueDelta    Decimal      @map("value_delta") @db.Decimal(16, 2)
  productUnitId String?      @map("product_unit_id") @db.Uuid
  /// GOODS_RECEIPT (5.1); ADJUSTMENT / TRANSFER (5.2).
  referenceType String       @map("reference_type") @db.VarChar(30)
  referenceId   String       @map("reference_id") @db.Uuid
  actorId       String       @map("actor_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  product     Product      @relation(fields: [productId], references: [id])
  branch      Branch       @relation(fields: [branchId], references: [id])
  productUnit ProductUnit? @relation(fields: [productUnitId], references: [id])
  actor       User         @relation(fields: [actorId], references: [id])

  @@index([productId, branchId, createdAt])
  @@index([branchId, createdAt])
  @@index([referenceType, referenceId])
  @@index([productUnitId])
  @@map("stock_movements")
}

/// Moving weighted-average cost, organisation-wide per product (ADR-029).
model InventoryValuation {
  productId   String   @id @map("product_id") @db.Uuid
  averageCost Decimal  @map("average_cost") @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id])

  @@map("inventory_valuations")
}
